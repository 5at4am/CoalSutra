# --- Database ---
# Used by the backend (SQLAlchemy) and the Postgres container.
POSTGRES_USER=cmpdi
POSTGRES_PASSWORD=cmpdi
POSTGRES_DB=cmpdi
POSTGRES_PORT=5432

# SQLAlchemy connection string for the backend service (service name "db").
# For local (non-Docker) backend runs, use localhost instead of db.
DATABASE_URL=postgresql+psycopg2://cmpdi:cmpdi@localhost:5432/cmpdi

# --- LLM ---
# Generic provider-agnostic API key for the LLM used in RAG / extraction / report generation.
# Empty = pipeline falls back to deterministic rule-based extraction.
LLM_API_KEY=replace-me
# OpenAI-compatible endpoint. Point LLM_BASE_URL at a local Ollama/vLLM/Azure
# gateway to use a different model without code changes. Example Groq:
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60
# Embedding provider: "api" (OpenAI-compatible /embeddings on LLM_BASE_URL) or
# "hash" (local vectors — required when the chat provider has no embeddings
# endpoint, e.g. Groq). Dimension MUST match EMBEDDING_DIM + alembic 0004.
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- OCR ---
# Which OCR provider the document router uses for scanned/low-quality inputs.
# Options:
#   tesseract   pytesseract + poppler (default in the backend Docker image;
#               needs the tesseract binary + poppler installed).
#   rapidocr    pure-pip ONNX OCR + PyMuPDF rasterizer. No system binaries —
#               recommended for local Windows/macOS dev boxes.
#   huggingface hosted image-to-text OCR via the Hugging Face Inference API
#               (set HUGGINGFACE_API_KEY + OCR_HF_MODEL). PDFs are rasterized
#               client-side with PyMuPDF, pages are OCR'd server-side.
# If the configured provider is unusable at runtime (missing binary, network or
# endpoint error), extraction auto-falls back to "rapidocr".
OCR_PROVIDER=tesseract
# Hugging Face token for the "huggingface" OCR provider (keep empty otherwise).
HUGGINGFACE_API_KEY=
# image-to-text model served on the HF Inference API endpoint.
OCR_HF_MODEL=microsoft/trocr-base-printed

# --- Ports (optional overrides) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000